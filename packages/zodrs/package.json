{
  "name": "zodrs",
  "version": "0.1.2",
  "description": "TypeScript-first schema validation with static type inference, backed by a Rust core. Drop-in replacement for zod v4.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaphorics/zodrs.git",
    "directory": "packages/zodrs"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist-cjs/classic/index.js",
  "types": "./dist/classic/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/classic/index.d.ts",
      "import": "./dist/classic/index.js",
      "require": "./dist-cjs/classic/index.js"
    },
    "./mini": {
      "types": "./dist/mini/index.d.ts",
      "import": "./dist/mini/index.js",
      "require": "./dist-cjs/mini/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist-cjs/core/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js",
      "require": "./dist-cjs/locales/index.js"
    },
    "./v4": {
      "types": "./dist/classic/index.d.ts",
      "import": "./dist/classic/index.js",
      "require": "./dist-cjs/classic/index.js"
    },
    "./v4/core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist-cjs/core/index.js"
    },
    "./v4/locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js",
      "require": "./dist-cjs/locales/index.js"
    },
    "./v4-mini": {
      "types": "./dist/mini/index.d.ts",
      "import": "./dist/mini/index.js",
      "require": "./dist-cjs/mini/index.js"
    },
    "./v4/mini": {
      "types": "./dist/mini/index.d.ts",
      "import": "./dist/mini/index.js",
      "require": "./dist-cjs/mini/index.js"
    },
    "./v4/locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js",
      "require": "./dist-cjs/locales/*.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#module-url": {
      "import": "./dist/core/module-url.js",
      "require": "./dist-cjs/core/module-url-cjs.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "native",
    "wasm",
    "!dist/**/*.test.*",
    "!dist/**/*.selftest.*",
    "!dist-cjs/**/*.test.*",
    "!dist-cjs/**/*.selftest.*",
    "!wasm/node_modules",
    "!wasm/package-lock.json",
    "!wasm/*.debug.wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json',JSON.stringify({type:'commonjs',imports:{'#module-url':'./core/module-url-cjs.js'}})+'\\n')\"",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json',JSON.stringify({type:'commonjs',imports:{'#module-url':'./core/module-url-cjs.js'}})+'\\n')\"",
    "build:native": "cd ../../crates/zodrs-node && napi build --platform --release --target x86_64-unknown-linux-gnu --output-dir ../../packages/zodrs/native",
    "build:wasm": "cd ../../crates/zodrs-node && napi build --platform --release --target wasm32-wasip1-threads --output-dir ../../packages/zodrs/wasm && cd ../../packages/zodrs && node -e \"const fs=require('fs');fs.rmSync('wasm/zodrs_node.wasm32-wasi.debug.wasm',{force:true});fs.copyFileSync('wasm/index.d.ts','wasm/zodrs_node.wasi.d.cts')\"",
    "selftest:native": "ZODRS_LOADER=native node dist/core/loader.selftest.js",
    "selftest:wasm": "ZODRS_LOADER=wasm node dist/core/loader.selftest.js",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "prepack": "pnpm run build && pnpm run build:native && pnpm run build:wasm && pnpm run selftest:native && pnpm run selftest:wasm && pnpm run verify:artifacts",
    "test": "node --test scripts/*.test.mjs && vitest run"
  },
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@napi-rs/wasm-runtime": "1.1.6"
  },
  "publishConfig": {
    "name": "zod-rs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6"
  }
}
