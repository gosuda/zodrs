{
  "name": "zodrs-wasm",
  "version": "0.1.0",
  "private": true,
  "napi": {
    "binaryName": "zodrs_node",
    "targets": [
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 4000,
      "maximumMemory": 65536,
      "browser": {
        "fs": false,
        "asyncInit": false,
        "buffer": false,
        "errorEvent": true
      }
    }
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@napi-rs/wasm-runtime": "1.2.2"
  }
}
